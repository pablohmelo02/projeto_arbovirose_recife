# Copie para `.env` e preencha. `.env` é ignorado pelo Git (ver .gitignore).
#
# IMPORTANTE: este arquivo contém apenas PLACEHOLDERS. Nenhum valor aqui é
# uma credencial funcional, e nenhum valor daqui deve ir para produção sem
# ser substituído. As chaves do MinIO em particular não têm default fraco
# de propósito — se ficarem vazias, `docker compose up` falha em vez de
# subir um serviço com senha previsível.

# ---------------------------------------------------------------------------
# Fonte epidemiológica e territorial (CKAN — Portal de Dados Abertos do Recife)
# ---------------------------------------------------------------------------
CKAN_BASE_URL=https://dados.recife.pe.gov.br
CKAN_DATASET=casos-de-dengue-zika-e-chikungunya
CKAN_TERRITORIO_DATASET=mapas-de-limites-e-divisoes-territoriais

# ---------------------------------------------------------------------------
# Data Lake (MinIO / S3 compatível) — necessário apenas para a cadeia
# canônica Bronze/Silver/Gold. O dashboard publicado NÃO usa nada disto.
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=DEFINA_UMA_CHAVE_DE_ACESSO
MINIO_SECRET_KEY=DEFINA_UMA_CHAVE_SECRETA_FORTE
MINIO_BUCKET=datalake

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
HTTP_TIMEOUT=30

# ---------------------------------------------------------------------------
# INMET — anos a baixar do ZIP histórico anual (não usa CKAN, ver README)
# ---------------------------------------------------------------------------
INMET_ANOS=2024

# ---------------------------------------------------------------------------
# CEMADEN (opcional) — os defaults do código já são os endpoints reais
# validados em reports/climate_source_analysis/. Só sobrescreva se estiver
# investigando uma mudança de endpoint.
# ---------------------------------------------------------------------------
# CEMADEN_WFS_URL=https://gsc.cemaden.gov.br/geoserver/cemaden_dev/wfs
# CEMADEN_STATUS_URL=https://resources.cemaden.gov.br/graficos/interativo/getJson2.php
# CEMADEN_HORARIO_URL=https://mapservices.cemaden.gov.br/MapaInterativoWS/resources/horario
CEMADEN_HORAS_INGESTAO=48

# ---------------------------------------------------------------------------
# Clima em grade (reanálise ERA5 / ERA5-Land via Open-Meteo Archive)
# Sem autenticação. Só sobrescreva para apontar para outro provedor.
# ---------------------------------------------------------------------------
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
